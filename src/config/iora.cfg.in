# IORA Configuration File
# =======================
# This file configures the IORA server. Edit values as needed for your
# deployment. Paths are filled in at install time from the install prefix.
#
# Lines that start with "#? " are optional settings that are off by default.
# Delete the "#? " at the start of a line to enable it.
#
# Note: keep each array on one line, and never put a "#" comment inside an
# array. Such a comment makes the whole file fail to parse, and then every
# setting falls back to its default.

# ---------------------------------------------------------------------------
# HTTP server configuration
# ---------------------------------------------------------------------------
[iora.server]
port = 8080 # Port on which the WebhookServer listens for incoming HTTP requests

# ---------------------------------------------------------------------------
# TLS/SSL configuration for the HTTP server (off by default)
# ---------------------------------------------------------------------------
# Enabling TLS requires the certificate, key and CA files to exist; if they
# are missing, startup fails.
#? [iora.server.tls]
#? certFile = "@IORA_CONFIG_DIR@/tls/server.crt"   # TLS certificate file used for HTTPS
#? keyFile = "@IORA_CONFIG_DIR@/tls/server.key"    # Private key file for the TLS certificate
#? caFile = "@IORA_CONFIG_DIR@/tls/ca.crt"         # CA certificate file for client certificate validation
#? requireClientCert = false                       # Whether to require client certificates (mutual TLS)

# ---------------------------------------------------------------------------
# Persistent state configuration
# ---------------------------------------------------------------------------
[iora.state]
file = "@IORA_CONFIG_DIR@/iora_state.json"         # File used by JsonFileStore for persistent state

# ---------------------------------------------------------------------------
# Logging configuration
# ---------------------------------------------------------------------------
[iora.log]
level = "debug"                   # Log verbosity: trace, debug, info, warning, error, fatal
file = "@IORA_LOG_DIR@/iora"      # Base name for log files; logs are rotated daily
async = true                      # Enable asynchronous logging for better performance
retentionDays = 7                 # Number of days to keep old log files before deletion
timeFormat = "%Y-%m-%d %H:%M:%S"  # Format string for timestamps in log entries
compressAfterDays = 0             # Compress rotated log files older than N days (0 = off)

# ---------------------------------------------------------------------------
# Thread pool configuration
# ---------------------------------------------------------------------------
[iora.threadPool]
minThreads = 2                    # Minimum number of worker threads in the thread pool
maxThreads = 8                    # Maximum number of worker threads in the thread pool
queueSize = 128                   # Maximum number of tasks that can be queued for execution
idleTimeoutSeconds = 60           # Idle time for threads before they get pruned

# ---------------------------------------------------------------------------
# Module loading configuration
# ---------------------------------------------------------------------------
[iora.modules]
directory = "@IORA_MODULES_DIR@"  # Directory containing module shared libraries
#? autoLoad = true                # Load modules at startup (default: true)
# Modules to load, in this order (file names in the directory above). If not
# set, every module file in the directory is loaded, in no fixed order.
#? modules = ["base_module.so", "dependent_module.so"]

# ---------------------------------------------------------------------------
# Optional subsystems (all on by default)
# ---------------------------------------------------------------------------
#? [iora.features]
#? server = true                  # HTTP server (WebhookServer)
#? jsonFileStore = true           # JsonFileStore persistent state
#? stateStore = true              # In-memory state store
#? expiringCache = true           # Expiring cache
#? modules = true                 # Module loader
